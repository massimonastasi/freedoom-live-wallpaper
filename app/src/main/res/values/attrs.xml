<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Reuses the framework entries/entryValues so the XML reads like a ListPreference. -->
    <declare-styleable name="RadioListPreference">
        <attr name="android:entries" />
        <attr name="android:entryValues" />
    </declare-styleable>

    <!--
        Not android:summary. The framework attribute is drawn by the base class as well, so
        the same paragraph would appear both folded and unfolded.
    -->
    <declare-styleable name="AccordionPreference">
        <attr name="body" format="string" />
    </declare-styleable>
</resources>
