<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Only rates the draw loop actually offers. Measured on a Pixel 6a: 20 fps costs 12.0%
        of one core and 10 fps costs 9.2%, so the saving is real but not proportional - there
        is a fixed cost per frame delivered that does not scale with the rate.
    -->
    <string-array name="fps_labels">
        <item>20 fps</item>
        <item>15 fps</item>
        <item>10 fps</item>
    </string-array>

    <string-array name="fps_values">
        <item>20</item>
        <item>15</item>
        <item>10</item>
    </string-array>

    <string-array name="background_labels">
        <item>Dungeon floor, changes with the difficulty</item>
        <item>A photo of your own</item>
        <item>A flat colour</item>
    </string-array>

    <string-array name="background_values">
        <item>dynamic</item>
        <item>photo</item>
        <item>colour</item>
    </string-array>

    <!--
        Palette indices, not colour values: the colour follows whichever WAD is loaded. Each
        was found by searching PLAYPAL for the entry nearest the named hue, so these are the
        active palette's own colours rather than approximations laid over it.
    -->
    <string-array name="palette_labels">
        <item>Black</item>
        <item>Grey</item>
        <item>White</item>
        <item>Red</item>
        <item>Green</item>
        <item>Blue</item>
        <item>Brown</item>
        <item>Yellow</item>
    </string-array>

    <string-array name="palette_values">
        <item>0</item>
        <item>99</item>
        <item>4</item>
        <item>184</item>
        <item>122</item>
        <item>204</item>
        <item>73</item>
        <item>164</item>
    </string-array>
</resources>
