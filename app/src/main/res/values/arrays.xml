<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Palette indices, not colour values: the colour follows whichever WAD is loaded.
        Ten of them, drawn as two rows of five.

        Each was found by searching the bundled PLAYPAL for the entry nearest a target hue,
        so these are the palette's own colours rather than approximations laid over it. That
        search is also why there is no teal here: the nearest entry to one came back a plain
        grey, #6F6F6F, so the slot went to a cream the palette does have. Picking by
        measurement rather than by name is what stops a swatch from lying about its colour.
    -->
    <string-array name="palette_labels">
        <item>Black</item>
        <item>Grey</item>
        <item>White</item>
        <item>Cream</item>
        <item>Brown</item>
        <item>Red</item>
        <item>Orange</item>
        <item>Yellow</item>
        <item>Green</item>
        <item>Blue</item>
    </string-array>

    <string-array name="palette_values">
        <item>0</item>
        <item>97</item>
        <item>4</item>
        <item>210</item>
        <item>72</item>
        <item>182</item>
        <item>218</item>
        <item>162</item>
        <item>119</item>
        <item>198</item>
    </string-array>
</resources>
