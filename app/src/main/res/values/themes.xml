<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Material 3, following the system's own palette. minSdk is 31, so dynamic colour is
        available on every device this runs on and there is no branch to maintain: the
        settings look like the rest of the phone instead of like a theme somebody chose.

        DayNight because forcing a light screen on someone who chose dark is the one theming
        decision users notice immediately.

        NoActionBar: the bar is a MaterialToolbar inside the layout instead.

        No preference library underneath any more. The screen is a plain layout of Material 3
        widgets, so there is one styling system rather than two arguing with each other.
    -->
    <style name="AppTheme" parent="Theme.Material3.DynamicColors.DayNight.NoActionBar" />

    <!--
        A section header: titleSmall on colorPrimary, 56dp tall, flush with the 16dp column
        the rows below it use. Taken from the design's own Section header building block.
    -->
    <style name="SectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <!-- The explanation under a section header. -->
    <style name="SectionParagraph">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!--
        A List: one rounded container that clips its rows. The corners belong to the group,
        not to each row - the design draws square rows inside a 16dp container, and rounding
        every row reads as a stack of separate cards instead of a single control.
    -->
    <style name="ListGroup">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/list_group_background</item>
        <item name="android:clipToOutline">true</item>
    </style>
</resources>
