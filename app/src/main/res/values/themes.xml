<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Material 3, following the system's own palette. minSdk is 31, so dynamic colour is
        available on every device this runs on and there is no branch to maintain: the
        settings look like the rest of the phone instead of like a theme somebody chose.

        DayNight because forcing a light screen on someone who chose dark is the one theming
        decision users notice immediately.

        NoActionBar: the bar is a MaterialToolbar inside the layout instead. The window one
        was drawn over the list rather than above it, which put the first category header
        underneath the title.

        preferenceTheme is required: without it androidx.preference falls back to its own
        pre-Material styling and the rows do not match anything around them.
    -->
    <style name="AppTheme" parent="Theme.Material3.DynamicColors.DayNight.NoActionBar">
        <item name="preferenceTheme">@style/AppPreferenceTheme</item>
    </style>


    <!--
        Section headers to the Material 3 list spec: titleSmall on colorPrimary. The library's
        own default is a small grey label, which reads as disabled text rather than as a
        heading. The colour is the dynamic primary, so it still follows the system palette.
    -->
    <style name="AppPreferenceTheme" parent="@style/PreferenceThemeOverlay">
        <item name="preferenceCategoryTitleTextAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="preferenceCategoryTitleTextColor">?attr/colorPrimary</item>
    </style>

    <!--
        One radio option, to the Material 3 radio-button spec: a 56dp list item, the label in
        bodyLarge on onSurface, and a 16dp gap between the control and its label. The 20dp
        control and its 48dp touch target come from MaterialRadioButton itself, which is the
        reason the rows are built from that class rather than from android.widget.RadioButton.

        The state list colour is not set here. Material3 already tints the control with
        colorPrimary when selected and onSurfaceVariant when not, and restating it would be
        the one place dynamic colour stopped following the system.
    -->    <style name="RadioRow" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
</resources>
