<?xml version="1.0" encoding="utf-8"?>
<!--
    Dark at the very top, gone by the bottom - the reverse of header_scrim, which darkens
    towards its own text at the foot of the header.

    It is drawn taller than the status bar it protects, which is the whole reason for the
    gradient: a band exactly as tall as the inset has to end somewhere, and a flat one ends
    in a visible edge across the page. Fading out below the clock means there is no edge to
    see, and the strongest part still sits where the clock is.

    Literal black, like header_scrim: it darkens what is behind it rather than saying
    anything about the palette, so it is not a theme role.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerColor="#4D000000"
        android:endColor="#00000000"
        android:startColor="#99000000"
        android:type="linear" />
</shape>
