<?xml version="1.0" encoding="utf-8"?>
<!--
    The card the wallpaper picker shows.

    It used to be @mipmap/ic_launcher, which is square, and the picker draws its thumbnail
    into a portrait phone-shaped card - so the icon was stretched to roughly one by two. A
    layer-list fixes that without needing artwork at the card's aspect ratio: the background
    fills whatever shape it is given, and the icon is placed with gravity="center", which
    positions it at its own size instead of scaling it to the bounds.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:drawable="@color/ic_launcher_background" />

    <item
        android:width="96dp"
        android:height="96dp"
        android:drawable="@mipmap/ic_launcher_foreground"
        android:gravity="center" />

</layer-list>
