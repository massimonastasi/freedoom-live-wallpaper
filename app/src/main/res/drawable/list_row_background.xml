<?xml version="1.0" encoding="utf-8"?>
<!--
    One row of a list. Square, because the corners belong to the group: the design's List is a
    single container with a 16dp radius that clips its children, and the rows inside it are
    separated by a 2dp gap rather than each being its own rounded shape. Rounding every row
    was mine, and it read as a stack of separate cards instead of one control.

    surface for a row at rest and secondaryContainer for the chosen one, which is what the
    component's tokens say - the rows are darker than the section behind them, not lighter.

    state_activated rather than state_selected: selected is a transient touch state on
    Android, activated is the persistent "this is the chosen one" that a radio row needs.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_activated="true">
        <color android:color="?attr/colorSecondaryContainer" />
    </item>

    <item>
        <color android:color="?attr/colorSurface" />
    </item>

</selector>