<?xml version="1.0" encoding="utf-8"?>
<!--
    Material 3 throughout, and nothing else. Every section has the same shape: a header, the
    controls, then one folded row carrying that section's explanation. Nothing on this screen
    explains itself until it is asked to.
-->
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="@string/settings_frame_rate">

        <io.github.massimonastasi.freedoomlw.RadioListPreference
            android:defaultValue="20"
            android:entries="@array/fps_labels"
            android:entryValues="@array/fps_values"
            android:key="fps" />

        <io.github.massimonastasi.freedoomlw.AccordionPreference
            android:key="fps_note"
            android:title="@string/settings_details"
            app:body="@string/settings_frame_rate_note" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_background">

        <io.github.massimonastasi.freedoomlw.RadioListPreference
            android:defaultValue="dynamic"
            android:entries="@array/background_labels"
            android:entryValues="@array/background_values"
            android:key="background" />

        <!-- Both of these appear only under the choice they belong to. -->
        <Preference
            android:key="background_photo"
            android:title="@string/settings_background_photo" />

        <io.github.massimonastasi.freedoomlw.SwatchListPreference
            android:defaultValue="0"
            android:entries="@array/palette_labels"
            android:entryValues="@array/palette_values"
            android:key="background_colour"
            android:title="@string/settings_background_colour" />

        <io.github.massimonastasi.freedoomlw.AccordionPreference
            android:key="background_note"
            android:title="@string/settings_details"
            app:body="@string/settings_background_note" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_scene">

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="readout"
            android:title="@string/settings_readout" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_sprites">

        <io.github.massimonastasi.freedoomlw.RadioListPreference
            android:defaultValue="bundled"
            android:key="sprites" />

        <Preference
            android:key="wad"
            android:title="@string/settings_wad" />

        <io.github.massimonastasi.freedoomlw.AccordionPreference
            android:key="wad_note"
            android:title="@string/settings_details"
            app:body="@string/settings_wad_note" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_about">

        <Preference
            android:key="save"
            android:title="@string/settings_save" />

        <Preference
            android:key="set_wallpaper"
            android:title="@string/settings_set_wallpaper" />

        <Preference
            android:key="reset"
            android:title="@string/settings_reset" />

        <io.github.massimonastasi.freedoomlw.AccordionPreference
            android:key="about_note"
            android:title="@string/settings_details"
            app:body="@string/settings_about_note" />

        <!-- Body set in code: it is the licence files themselves, read from the assets. -->
        <io.github.massimonastasi.freedoomlw.AccordionPreference
            android:key="notices"
            android:title="@string/settings_licences" />

    </PreferenceCategory>

</PreferenceScreen>
