<?xml version="1.0" encoding="utf-8"?>
<!--
    Material 3 throughout, and nothing else. Every section is the same shape: a header, a
    paragraph saying what the section is for, then the controls.

    Choices apply as they are made. There is no Save: the wallpaper reads its settings when it
    next becomes visible, so a staged edit would only be a second state to keep in step with
    the first.

    Sprites and About are the two sections still to be finished against the design.
-->
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="@string/settings_visual">

        <io.github.massimonastasi.freedoomlw.ParagraphPreference
            android:key="visual_note"
            app:body="@string/settings_visual_note" />

        <io.github.massimonastasi.freedoomlw.SegmentedPreference
            android:defaultValue="20"
            android:entries="@array/fps_labels"
            android:entryValues="@array/fps_values"
            android:key="fps" />

        <io.github.massimonastasi.freedoomlw.SwitchRowPreference
            android:defaultValue="true"
            android:key="readout"
            android:summary="@string/settings_readout_note"
            android:title="@string/settings_readout" />

        <io.github.massimonastasi.freedoomlw.SwitchRowPreference
            android:defaultValue="false"
            android:key="god_mode"
            android:summary="@string/settings_god_mode_note"
            android:title="@string/settings_god_mode" />

        <io.github.massimonastasi.freedoomlw.SwitchRowPreference
            android:defaultValue="false"
            android:key="debug"
            android:summary="@string/settings_debug_note"
            android:title="@string/settings_debug" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_background">

        <io.github.massimonastasi.freedoomlw.OptionListPreference
            android:defaultValue="dynamic"
            android:entries="@array/background_labels"
            android:entryValues="@array/background_values"
            android:key="background"
            app:captions="@array/background_captions" />

        <!-- Always drawn: the swatches are what "flat colour" means. -->
        <io.github.massimonastasi.freedoomlw.SwatchListPreference
            android:defaultValue="0"
            android:entries="@array/palette_labels"
            android:entryValues="@array/palette_values"
            android:key="background_colour" />

    </PreferenceCategory>

</PreferenceScreen>
