<?xml version="1.0" encoding="utf-8"?>
<!--
    One notice: a small label over its text.

    The same two styles the settings sections use, so a heading reads the same on both
    screens - SectionHeader is the wrong one here because these headings are labels inside a
    document rather than headers over a list, and the design draws them at labelSmall.

    Selectable body text: a licence is something people copy out of, and refusing that would
    be the one place this screen made the notice harder to honour.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/block_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorPrimary" />

    <TextView
        android:id="@+id/block_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textIsSelectable="true" />

</LinearLayout>