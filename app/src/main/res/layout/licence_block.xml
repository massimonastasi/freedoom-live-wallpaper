<?xml version="1.0" encoding="utf-8"?>
<!--
    One notice: a small label in primaryFixed over its text, 16dp all round, as the design
    draws it. labelSmall for the label so it reads as a heading without competing with the
    body, which is the part that actually has to be read.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/block_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorPrimary" />

    <TextView
        android:id="@+id/block_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurface"
        android:textIsSelectable="true" />

</LinearLayout>