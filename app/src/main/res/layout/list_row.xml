<?xml version="1.0" encoding="utf-8"?>
<!--
    One row of a Material 3 list: an optional leading control, a label with an optional
    supporting line, and an optional trailing control.

    Measured off the design''s own list item rather than estimated: on a 340dp row the content
    starts at 16, is 244 wide, and the trailing element starts at 272 - so the text and the
    control are 12dp apart, and the text sits 10dp from the top and bottom of a 64dp row.

    The 12dp was missing entirely, which is why a two-line supporting text ran into the
    switch beside it. minHeight rather than a fixed height, because two lines of bodyLarge
    plus bodyMedium is taller than 64 and a row that clips its own text is worse than a row
    that grows.

    Every variant on this screen is this one layout with pieces hidden - a radio row, a switch
    row, a row that opens something else. Three layouts that differ by which child is visible
    would be three places to change a padding.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/list_row_background"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <com.google.android.material.radiobutton.MaterialRadioButton
        android:id="@+id/row_radio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:clickable="false"
        android:duplicateParentState="true"
        android:focusable="false" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/row_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/row_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <!--
            Anything the row carries beyond its text: today only the colour swatches, which
            the design draws inside the "flat colour" row rather than under it.
        -->
        <FrameLayout
            android:id="@+id/row_extra"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

    </LinearLayout>

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/row_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/row_action"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@null"
        android:src="@drawable/ic_chevron"
        android:visibility="gone" />

</LinearLayout>
