<?xml version="1.0" encoding="utf-8"?>
<!--
    One Material 3 list item, from the library's own component.

    ListItemCardView arrived in Material 1.14.0 with M3 Expressive. Everything this row used
    to state by hand now comes from it:

      cardBackgroundColor  a selector, so the chosen row is tinted and the rest are not
      shapeAppearance      a state list, so corners answer to selection and pressing
      contentPadding       16dp leading and trailing, 10dp top and bottom
      ripple               the list item's own ripple colour

    Those paddings are worth noting: they are the same numbers that were measured off the
    design file by hand - 16 and 10 - which is a good sign that the reading was right, and a
    better reason to stop maintaining them here.

    The children carry the library's list-item styles too, so the label and supporting text
    take their typography and their state colours from Material rather than from this file,
    and the radio and switch come pre-set to non-clickable with the correct tints: the row is
    the touch target, not the control inside it.

    The Segmented style is the one the design uses - a group of rows that share a container.
    Which corner each row gets is set from code, by position; see SettingsActivity.shapeGroup.
-->
<com.google.android.material.listitem.ListItemCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Material3.ListItemCardView.Segmented"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:swipeEnabled="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal">

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/row_radio"
            style="@style/Widget.Material3.RadioButton.ListItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:duplicateParentState="true" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/row_label"
                style="@style/Widget.Material3.TextView.ListItem.LabelText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                tools:text="Dungeon floor" />

            <TextView
                android:id="@+id/row_caption"
                style="@style/Widget.Material3.TextView.ListItem.SupportingText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:visibility="gone"
                tools:text="Changes with the difficulty"
                tools:visibility="visible" />

            <!-- Anything the row carries beyond its text: the colour swatches live in theirs. -->
            <FrameLayout
                android:id="@+id/row_extra"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/row_switch"
            style="@style/Widget.Material3.Switch.ListItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/row_action"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:visibility="gone"
            app:iconPadding="0dp"
            app:iconSize="20dp" />

    </LinearLayout>

</com.google.android.material.listitem.ListItemCardView>
