<?xml version="1.0" encoding="utf-8"?>
<!--
    The flat colours, as two rows of five.

    Always visible, whether or not "Flat colour" is the chosen background: they are what that
    option means, and hiding them until it is picked asks the user to choose blind.

    Five columns rather than a horizontally scrolling row, so every colour is on screen at
    once and none can hide past the edge.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <GridLayout
        android:id="@+id/swatch_grid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="5" />

</FrameLayout>
