<?xml version="1.0" encoding="utf-8"?>
<!--
    Holds exactly one list row.

    Two frames, and the outer one is not decoration. PreferenceViewHolder looks its ids up
    *beneath* the row's view, so an id on the layout root is never found and the bind crashes
    on the cast. This project has now hit that three times - the radio group, the option list,
    and this - which is why every custom preference layout here wraps its content.

    The inset and the 1dp gap live here so a lone switch row lines up with a group of radio
    rows above it, which get theirs from their own container. It also carries the group's
    16dp corners, because a row on its own is still a group of one.

    Not the same thing as the design, and worth saying: there the three switches are a single
    List, one rounded container holding three square rows. Three separate preferences cannot
    be one container, so they are three containers of one. Matching it needs a preference that
    holds all three rows itself.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="?attr/colorSurfaceContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingTop="1dp"
    android:paddingEnd="16dp"
    android:paddingBottom="1dp">

    <FrameLayout
        android:id="@+id/row_host"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/list_group_background"
        android:clipToOutline="true" />

</FrameLayout>
