<?xml version="1.0" encoding="utf-8"?>
<!--
    One option, inflated once per entry. A layout rather than a constructor call because a
    style is applied to a view when it is inflated: passing a style resource to a widget's
    three-argument constructor sets its default style *attribute*, which is not the same
    thing and silently leaves the row unstyled.
-->
<com.google.android.material.radiobutton.MaterialRadioButton
    xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/RadioRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content" />
