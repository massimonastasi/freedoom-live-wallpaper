<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No permissions requested. No network, no background services. -->

    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="true" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!--
            The launcher icon opens the settings, which carry the button that sets the
            wallpaper. It used to open the picker directly, which was right when there was
            nothing else to show; now that there is, an icon that only ever hands you off is
            a dead end once the wallpaper is already set.
        -->
        <!--
            FLW is the label of this activity alone, and that is the whole of it: a launcher
            shows the activity's label when it has one and falls back to the application's
            otherwise. Everything else keeps the full name - the wallpaper picker reads the
            service's label, the settings header reads app_name from the layout, and the
            licences screen its own. Nothing else on the phone changes.
        -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/launcher_label">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <activity
            android:name=".LicencesActivity"
            android:exported="false"
            android:label="@string/settings_licences" />

        <!--
            Transparent and finishes in onCreate, so it never draws: no edge-to-edge or
            predictive back obligations follow from it under targetSdk 36.
        -->
        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".FreedoomWallpaperService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" />
        </service>

    </application>

</manifest>
